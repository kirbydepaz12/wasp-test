{
  "$schema": "node_modules/wrangler/config-schema.json",
  // STAGING ONLY. Keep this Worker name distinct from the production Worker.
  "name": "wasp-test",
  "main": "src/index.js",
  "compatibility_date": "2025-10-01",
  "triggers": { "crons": ["* * * * *"] },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/audio/*", "/art/*", "/site/*", "/mobile", "/mobile/*", "/rest/*"]
  },
  // No IDs on purpose: Wrangler creates these on first deploy and keeps them linked.
  "r2_buckets": [{ "binding": "MUSIC","bucket_name": "wasp-v16-staging","preview_bucket_name": "wasp-v16-staging" }],
  "d1_databases": [{ "binding": "DB","database_id": "b3505f43-2be5-4b3d-ba23-83de4d75ce11","database_name": "wasp-v16-staging" }]
}
